# =====================================================================
# FaceAttend Mobile App (React Native / Expo) Environment Template
# =====================================================================
# Copy this file to '.env' in the client directory before starting Expo:
#   cp .env.example .env
# =====================================================================

# Base URL of the Node.js Express backend API
# For physical devices on LAN: http://192.168.1.X:5000
# For Android Emulator: http://10.0.2.2:5000
# For iOS Simulator: http://localhost:5000
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000
