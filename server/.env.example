# =====================================================================
# FaceAttend Server Environment Configuration Template
# =====================================================================
# Copy this file to '.env' in the server directory before starting the app:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# =====================================================================

# ---------------------------------------------------------------------
# 1. REQUIRED BOOT CONFIGURATION (Server will fail to start if missing)
# ---------------------------------------------------------------------

# Application HTTP server listening port (e.g. 5000)
PORT=5000

# MongoDB connection string (Local instance or MongoDB Atlas cluster)
# Example: mongodb://localhost:27017/faceattend
MONGODB_URI=mongodb://127.0.0.1:27017/faceattend

# Secret key used for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars

# JWT token expiration duration (e.g. '7d', '24h', '3600s')
JWT_EXPIRES_IN=7d

# Email credentials for sending OTP verification codes and system notifications via SMTP
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_smtp_app_password

# Base URL of the web frontend client (used for CORS policy and email redirect links)
CLIENT_URL=http://localhost:3000

# Redis connection URL for session tracking, caching, and BullMQ background queues
# Example: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379


# ---------------------------------------------------------------------
# 2. OPTIONAL CONFIGURATION & TUNING (Sane defaults will be used if omitted)
# ---------------------------------------------------------------------

# Base URL for the Python FaceNet AI face recognition microservice
# Default: http://127.0.0.1:5000
FACENET_SERVICE_URL=http://127.0.0.1:5000

# Allow mobile devices on LAN to access port 8081 (true/false)
# Default: false
ALLOW_LAN_8081=false

# Number of consecutive face detections required before marking attendance
# Default: 2
DETECTION_THRESHOLD=2

# Time window in seconds for accumulating consecutive face detections
# Default: 3
DETECTION_WINDOW_SECONDS=3

# Cosine similarity threshold for face embedding recognition match (0.0 to 1.0)
# Higher values demand closer face matches (0.6 recommended for FaceNet 512-dim vectors)
# Default: 0.6
FACE_MATCH_THRESHOLD=0.6
